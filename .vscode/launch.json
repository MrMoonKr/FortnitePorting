{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FortnitePorting Debug",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build FortnitePorting",
      "program": "${workspaceFolder}/FortnitePorting/bin/Debug/net10.0/win-x64/FortnitePorting.exe",
      "cwd": "${workspaceFolder}/FortnitePorting/bin/Debug/net10.0/win-x64",
      "stopAtEntry": false,
      "console": "internalConsole",
      "justMyCode": true
    },
    {
      "name": "FortnitePorting Release Debug",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build FortnitePorting Release",
      "program": "${workspaceFolder}/FortnitePorting/bin/Release/net10.0/win-x64/FortnitePorting.exe",
      "cwd": "${workspaceFolder}/FortnitePorting/bin/Release/net10.0/win-x64",
      "stopAtEntry": false,
      "console": "internalConsole",
      "justMyCode": true
    },
    {
      "name": "Attach to FortnitePorting",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
